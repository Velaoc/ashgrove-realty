<% title @contact.display_name %>

<section class="md-page md-stack">
  <header class="md-actions" style="justify-content: space-between; align-items: flex-start; flex-wrap: wrap;">
    <div>
      <p class="md-section__eyebrow">Contact</p>
      <h1><%= @contact.display_name %></h1>
      <p class="text-md-on-surface-variant"><%= [ @contact.role.humanize, @contact.title ].compact.join(" · ") %></p>
    </div>
    <div class="md-actions">
      <%= link_to "Edit", edit_crm_contact_path(@contact), class: "md-button md-button--tonal" %>
      <%= button_to "Delete", crm_contact_path(@contact), method: :delete, class: "md-button md-button--text", form: { data: { turbo_confirm: "Delete this contact?" } } %>
    </div>
  </header>

  <%= render "foundation/crm/shared/subnav" %>

  <div class="table-scroll">
    <table>
      <tbody>
        <tr><th>Role</th><td><%= @contact.role.humanize %></td></tr>
        <tr><th>Email</th><td><%= @contact.email.presence || "—" %></td></tr>
        <tr><th>Phone</th><td><%= @contact.phone.presence || "—" %></td></tr>
        <tr><th>Owner</th><td><%= crm_user_label(@contact.owner) %></td></tr>
      </tbody>
    </table>
  </div>

  <section class="md-card md-card--outlined md-stack">
    <h2>Deals</h2>
    <% deals = @contact.opportunities.includes(:pipeline_stage).ordered %>
    <% if deals.any? %>
      <ul style="list-style: none; padding: 0; margin: 0;" class="md-stack">
        <% deals.each do |deal| %>
          <li>
            <%= link_to deal.name, crm_opportunity_path(deal) %>
            <span class="text-md-on-surface-variant"> · <%= deal.pipeline_stage&.name %> · <%= crm_money(deal.amount_cents, deal.currency) %></span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-md-on-surface-variant">No deals yet.</p>
    <% end %>
  </section>

  <%= render "foundation/crm/shared/timeline",
        record: @contact, notes: @notes, tasks: @tasks, activities: @activities,
        note: @note, task: @task, members: @members %>
</section>
